{
  "name": "call-later",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "call-later-alarm": "file:./modules/call-later-alarm",
    "date-fns": "^4.4.0",
    "expo": "~58.0.21",
    "expo-constants": "~58.0.13",
    "expo-contacts": "~58.0.10",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "node scripts/ensure-windows-ninja.js && expo run:android",
    "android:enable-long-paths": "node scripts/ensure-windows-long-paths.js",
    "android:reverse": "adb reverse tcp:8081 tcp:8081",
    "android:device": "node scripts/ensure-windows-ninja.js && adb reverse tcp:8081 tcp:8081 && set REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1&& expo run:android --device",
    "android:prebuild": "expo prebuild --platform android --clean",
    "android:uninstall": "adb uninstall com.calllater.app || exit 0",
    "android:rebuild": "npm run android:prebuild && npm run android:uninstall && npm run android:device",
    "android:rebuild:emu": "npm run android:prebuild && npm run android:uninstall && node scripts/ensure-windows-ninja.js && expo run:android",
    "ios": "expo run:ios",
    "ios:prebuild": "expo prebuild --platform ios --clean",
    "ios:rebuild": "npm run ios:prebuild && expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild --platform android",
    "typecheck": "tsc --noEmit"
  },
  "private": true
}
